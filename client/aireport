#!/usr/bin/env python3
"""aireport — write HTML experiment reports on the AI Platform report server.

Typical flow (what the pl-report skill tells Claude / Codex to do):

  aireport suggest "liver tumor segmentation"      # does the topic exist? closest matches + proposed slug
  aireport new-topic --slug liver-tumor-seg --name "Liver Tumor Segmentation" --confirmed   # only after the user OKs it
  aireport new-exp liver-tumor-seg --title "nnU-Net baseline"   # allocates 실험 N, pulls it to a local work dir
  aireport viewer --image ct.nii.gz --label gt.nii.gz --pred pred.nii.gz -o <dir>/assets/case01.vol.json
  ...edit <dir>/index.html (markdown island, metrics island, vol-island)...
  aireport check <dir>
  aireport push <dir>                               # uploads assets + page, prints the URL

Server URL: --url, $AIREPORT_URL, ~/.config/aireport/config.json, else the built-in default.
Author name: --owner / $AIREPORT_OWNER / config (`aireport config --owner 이름`).
Only `viewer`/`phantom` need numpy (+ nibabel or SimpleITK); everything else is stdlib.
"""
import argparse
import base64
import gzip
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_URL = "__AIREPORT_URL__"
if DEFAULT_URL.startswith("__"):  # not served by the report server (repo checkout) → built-in default
    DEFAULT_URL = "https://plreport.oncosoft.io"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "aireport" / "config.json"
WORKDIR = Path(os.environ.get("AIREPORT_WORKDIR", Path.home() / "aireport-work"))
STATE = ".aireport.json"
PALETTE = ["#e6194b", "#3cb44b", "#4363d8", "#f58231", "#911eb4", "#42d4f4", "#f032e6", "#bfef45", "#fabed4",
           "#469990", "#dcbeff", "#9a6324", "#fffac8", "#800000", "#aaffc3", "#808000", "#ffd8b1", "#000075"]
STATUSES = ["시작 전", "진행 중", "완료", "일시정지", "중단"]


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


LEGACY_URLS = {"http://10.101.1.183:8090"}  # saved by installs before the plreport.oncosoft.io domain


def load_config():
    try:
        cfg = json.loads(CONFIG.read_text("utf-8"))
    except (FileNotFoundError, ValueError):
        return {}
    if cfg.get("url", "").rstrip("/") in LEGACY_URLS:
        cfg["url"] = DEFAULT_URL
    return cfg


# ----------------------------------------------------------------------------- HTTP
class Api:
    def __init__(self, url, owner, token):
        self.url, self.owner, self.token = url.rstrip("/"), owner, token

    def request(self, method, path, body=None, raw=False, ctype=None):
        data, headers = None, {"X-Report-Author": urllib.parse.quote(self.owner or "")}
        if self.token:
            headers["X-Report-Token"] = self.token
        if body is not None:
            if isinstance(body, (bytes, bytearray)):
                data, headers["Content-Type"] = bytes(body), ctype or "application/octet-stream"
            else:
                data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
        req = urllib.request.Request(self.url + path, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=300) as r:
                payload = r.read()
        except urllib.error.HTTPError as e:
            payload = e.read()
            try:
                return e.code, json.loads(payload)
            except ValueError:
                return e.code, {"error": payload.decode("utf-8", "replace")[:500]}
        except urllib.error.URLError as e:
            die(f"cannot reach the report server at {self.url} ({e.reason}). Set --url or $AIREPORT_URL.")
        if raw:
            return 200, payload
        return 200, json.loads(payload) if payload else {}

    def ok(self, method, path, body=None, **kw):
        code, obj = self.request(method, path, body, **kw)
        if code >= 400:
            print(json.dumps(obj, ensure_ascii=False, indent=1), file=sys.stderr)
            die(f"{method} {path} → HTTP {code}: {obj.get('error', '')}")
        return obj


def quote_path(p):
    return "/".join(urllib.parse.quote(x) for x in p.split("/"))


def sha(b):
    return hashlib.sha256(b).hexdigest()


# ------------------------------------------------------------------------ commands
def cmd_config(a, api):
    cfg = load_config()
    for k in ("url", "owner", "token"):
        v = getattr(a, "set_" + k)
        if v is not None:
            cfg[k] = v
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), "utf-8")
    shown = dict(cfg, token="***" if cfg.get("token") else "")
    print(json.dumps(shown, ensure_ascii=False, indent=2))


def cmd_health(a, api):
    print(json.dumps(api.ok("GET", "/api/health"), ensure_ascii=False, indent=1))


def cmd_guide(a, api):
    path = "/AGENTS.md" if not a.doc else f"/docs/{a.doc.removesuffix('.md')}.md"
    _, body = api.request("GET", path, raw=True)
    sys.stdout.write(body.decode("utf-8") if isinstance(body, bytes) else json.dumps(body))


def cmd_topics(a, api):
