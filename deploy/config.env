# Deployment settings for 10.101.1.183. Override locally in deploy/config.local.env (git-ignored).
PORT=8090
PUBLIC_URL=https://plreport.oncosoft.io
# live site (local NVMe, ext4) and runtime scripts/logs
DATA_ROOT=/home/ubuntu/ai-platform-report-data
SITE_DIR=/home/ubuntu/ai-platform-report-data/site
# nightly snapshot target on the NAS (must be an NFS mount — the backup refuses a local dir)
BACKUP_DIR=/mnt/ai-platform-report
BACKUP_KEEP=90
# cron "minute hour" (server time zone is Asia/Seoul)
BACKUP_AT="30 2"
CONTAINER=ai-platform-report
IMAGE=ai-platform-report:latest
# optional shared write token (clients: aireport config --token …); empty = open on the LAN.
# Note: with a token set, the in-browser ✎ 편집 save is rejected.
REPORT_TOKEN=
SITE_TITLE="AI Platform Reports"
